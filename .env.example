# Telegram bot token from @BotFather
BOT_TOKEN=

# Public Render service URL, without trailing slash
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Your payment gateway base URL
PAYMENT_GATEWAY_BASE=https://mrkrishna-payment-api.onrender.com

# Set a strong random value before first launch.
# Claim admin by sending: /beadmin YOUR_CLAIM_CODE
# After the first admin is saved, this code is no longer needed.
ADMIN_CLAIM_CODE=change-this-to-a-long-random-secret

# Random webhook secret (letters, numbers, underscore, hyphen; 32+ chars recommended)
WEBHOOK_SECRET=change-this-to-another-long-random-secret

# Render persistent disk path (mount disk at /var/data)
DATABASE_PATH=/var/data/store.sqlite

# Optional defaults
INSTAGRAM_URL=https://instagram.com/mrkrishna.in
PORT=10000
